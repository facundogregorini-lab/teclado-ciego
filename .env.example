# Copiá este archivo a .env.local para probar con valores propios. Los valores reales van en Vercel → Settings → Environment Variables.

# PostHog: la Project API key es pública y ya está en analytics.js; acá solo cambia la del servidor (off la apaga).
POSTHOG_KEY=phc_tPTtLds2LH6udzJtXWcZzHsXyxUrTgxjSDyMmDThg3gz
# Solo servidor y scripts/posthog-query.cjs (lectura de métricas). Secreta: nunca en el código de la página.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=642163
POSTHOG_HOST=https://us.posthog.com

# Panel de cuentas (/admin): su clave (si falta, sirve FEEDBACK_KEY) y las cuentas de prueba que oculta, separadas por comas
ADMIN_KEY=
ADMIN_TEST_USERS=

# Mercado Pago (pago único)
MP_ACCESS_TOKEN=
MP_PRICE=4900
MP_REGULAR_PRICE=9900
PRICE_LABEL=
TECLADO_PREMIUM_USERS=

# Píxel de Meta y API de conversiones
META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo mientras se prueba en el Administrador de eventos → Probar eventos (después, borrarla)
META_TEST_EVENT_CODE=
# Dirección pública del sitio (vuelta de Mercado Pago y event_source_url de Meta). En Vercel: https://www.temploninja.com
